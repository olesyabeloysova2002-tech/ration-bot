def answer_callback(callback_query_id, text=""):
    try:
        requests.post(
            f"https://api.telegram.org/bot{BOT_TOKEN}/answerCallbackQuery",
            json={"callback_query_id": callback_query_id, "text": text, "show_alert": False},
            timeout=10
        )
    except Exception as e:
        log.error(f"answer_callback error: {e}")


def lookup_user(username):
    if not username:
        return None
    return USER_CACHE.get(username.lstrip("@").lower())


def cache_user(username, chat_id):
    if username and chat_id:
        USER_CACHE[username.lower()] = chat_id
        _save_state()


def reroll_reply_keyboard():
    return {
        "keyboard": [[{"text": "🔄 Другие блюда"}, {"text": "💳 Подписка"}]],
        "resize_keyboard": True,
        "one_time_keyboard": False,
        "is_persistent": True,
    }


def remove_keyboard():
    return {"remove_keyboard": True}


def generate_and_send(chat_id, req, add_reroll=True):
    """Сгенерировать план по req, отправить в Telegram, вернуть результат."""
    mode = req.get("_mode") or ("budget" if "meal_types" in req else "calorie")
    if mode == "budget":
        plan = generate_budget_plan(req)
    else:
        plan = generate_calorie_plan(req)
    if "error" in plan:
        send_telegram(chat_id, f"⚠️ {plan['error']}")
        return plan
    send_telegram(chat_id, format_telegram_message(plan), reply_markup=None)
    if add_reroll:
        send_telegram(
            chat_id,
            "📝 Напиши «ещё» — пришлю другие блюда\n"
            "💳 «Подписка» — информация о доступе",
        )
    return plan


def paywall_message(chat_id, telegram_username=""):
    """Сообщение для пользователей без подписки."""
    msg = (
        f"🔒 *Доступ закрыт*\n\n"
        f"Чтобы получать персональные меню, оформи подписку:\n"
        f"💰 *{PAYMENT_PRICE_RUB} ₽* — доступ на *{ACCESS_DAYS} дней*\n\n"
        f"📲 *Шаг 1.* Оплати по ссылке:\n"
        f"{PAYMENT_LINK}\n\n"
        f"📲 *Шаг 2.* Вернись сюда и напиши *«оплатила»* (или /paid)\n\n"
        f"✅ Доступ откроется автоматически.\n\n"
        f"_Подписка действует {ACCESS_DAYS} дней. Можно продлить в любой момент._"
    )
    send_telegram(chat_id, msg)


@app.route(f"/webhook/{BOT_TOKEN}", methods=["POST"])
def webhook():
    upd = request.get_json(silent=True) or {}

    # inline-кнопка
    cb = upd.get("callback_query")
    if cb:
        cb_id = cb.get("id")
        data = cb.get("data", "")
        chat_id = cb.get("message", {}).get("chat", {}).get("id")
        if data == "reroll" and chat_id in LAST_REQ:
            answer_callback(cb_id, "Готовлю другие варианты…")
            req = dict(LAST_REQ[chat_id])
            old_excl = set(req.get("exclude_ids") or [])
            if chat_id in LAST_PLAN:
                old_excl |= set(_collect_dish_ids(LAST_PLAN[chat_id]))
            req["exclude_ids"] = list(old_excl)
            LAST_REQ[chat_id] = req
            plan = generate_and_send(chat_id, req, add_reroll=True)
            if "error" not in plan:
                LAST_PLAN[chat_id] = plan
                _save_state()
        elif data == "buy":
            answer_callback(cb_id, "Открываю ссылку на оплату…")
            paywall_message(chat_id)
        elif data == "paid":
            if not has_access(chat_id):
                # Выдаём доступ автоматически (semi-automatic)
                grant_access(chat_id, ACCESS_DAYS)
                answer_callback(cb_id, f"✅ Доступ открыт на {ACCESS_DAYS} дней!", show_alert=True)
                send_telegram(chat_id, f"🎉 *Готово!* Подписка активна до *{time.strftime('%d.%m.%Y', time.localtime(ACCESS[chat_id]['expiry']))}*\n\nТеперь можешь заполнить форму на https://site-bb0.p.spru.io/ и получить меню прямо сюда 💌")
                # уведомляем админа
                send_telegram(ADMIN_CHAT_ID, f"💰 Новая подписка: chat_id={chat_id}, до {time.strftime('%d.%m.%Y %H:%M', time.localtime(ACCESS[chat_id]['expiry']))}")
            else:
                answer_callback(cb_id, f"Подписка уже активна до {time.strftime('%d.%m.%Y', time.localtime(ACCESS[chat_id]['expiry']))}", show_alert=True)
        else:
            answer_callback(cb_id, "Неизвестная команда")
        return jsonify({"ok": True})

    msg = upd.get("message")
    if not msg:
        return jsonify({"ok": True})
    chat_id = msg["chat"]["id"]
    username = msg.get("from", {}).get("username", "")
    text = (msg.get("text") or "").strip()
    if username:
        cache_user(username, chat_id)
    log.info(f"msg from @{username} ({chat_id}): {text}")

    text_lower = text.lower()

    if text.startswith("/start"):
        # приветствие + проверка подписки
        if has_access(chat_id):
            expiry_str = time.strftime('%d.%m.%Y', time.localtime(ACCESS[chat_id]['expiry']))
            send_telegram(
                chat_id,
                f"👋 С возвращением! Подписка активна до *{expiry_str}*\n\n"
                f"📋 Собери меню на https://site-bb0.p.spru.io/\n"
                f"Укажи свой @username, и меню придёт прямо сюда.\n\n"
                f"Команды: /test /menu /help /paid",
                reply_markup=reroll_reply_keyboard()
            )
        else:
            send_telegram(
                chat_id,
                f"Привет! 👋 Бот «Индивидуальный рацион».\n\n"
                f"🔒 Чтобы получить меню, оформи подписку: *{PAYMENT_PRICE_RUB} ₽* на *{ACCESS_DAYS} дней*.\n\n"
                f"📲 [Оплатить]({PAYMENT_LINK})\n"
                f"После оплаты напиши *«оплатила»* или нажми /paid",
                reply_markup=reroll_reply_keyboard()
            )
            paywall_message(chat_id)

    elif text.startswith("/paid") or text_lower in ("оплатила", "оплатил", "я оплатила", "я оплатил", "оплачено", "готово"):
        if not has_access(chat_id):
            grant_access(chat_id, ACCESS_DAYS, username)
            expiry_str = time.strftime('%d.%m.%Y', time.localtime(ACCESS[chat_id]['expiry']))
            send_telegram(
                chat_id,
                f"✅ *Доступ открыт на {ACCESS_DAYS} дней!*\n"
                f"Действует до *{expiry_str}*\n\n"
                f"Теперь заполни форму на https://site-bb0.p.spru.io/ "
                f"и укажи свой @username — меню придёт сюда 💌",
            )
            send_telegram(
                ADMIN_CHAT_ID,
                f"💰 Новая подписка: @{username} (chat_id={chat_id}), "
                f"до {expiry_str}",
            )
        else:
            expiry_str = time.strftime('%d.%m.%Y', time.localtime(ACCESS[chat_id]['expiry']))
            send_telegram(chat_id, f"Подписка уже активна до *{expiry_str}* ✅")

    elif text.startswith("/test"):
        if not has_access(chat_id):
            paywall_message(chat_id)
            return jsonify({"ok": True})
        req = {"_mode":"calorie","family_size":1,"persons":[{"kcal":"1500","meals":"3"}],"days":2,"budget":2000,"allergens":[],"dislikes":[]}
        plan = generate_and_send(chat_id, req, add_reroll=True)

    elif text.startswith("/menu"):
        if not has_access(chat_id):
            paywall_message(chat_id)
            return jsonify({"ok": True})
        req = {"_mode":"calorie","family_size":1,"persons":[{"kcal":"1500","meals":"3"}],"days":1,"budget":None,"allergens":[],"dislikes":[]}
        plan = generate_and_send(chat_id, req, add_reroll=True)

    elif text.startswith("/help"):
        send_telegram(chat_id, (
            "📖 *Как пользоваться:*\n\n"
            "1️⃣ Оформи подписку: /paid (или «оплатила»)\n"
            "2️⃣ Заполни форму на https://site-bb0.p.spru.io/\n"
            "3️⃣ В форме укажи свой @username из Telegram\n"
            "4️⃣ Меню придёт прямо в этот чат\n"
            "5️⃣ Напиши «ещё» — пришлю другие варианты блюд\n\n"
            f"💳 Подписка: *{PAYMENT_PRICE_RUB} ₽* / {ACCESS_DAYS} дней\n"
            f"🔗 Ссылка для оплаты: {PAYMENT_LINK}"
        ))

    elif text.startswith("/status"):
        # показать статус подписки (админ видит любого по chat_id)
        if chat_id == ADMIN_CHAT_ID and len(text.split()) > 1:
            try:
                target_cid = int(text.split()[1])
                if has_access(target_cid):
                    exp = time.strftime('%d.%m.%Y', time.localtime(ACCESS[target_cid]['expiry']))
                    send_telegram(chat_id, f"chat_id={target_cid}: подписка до {exp}")
                else:
                    send_telegram(chat_id, f"chat_id={target_cid}: нет подписки")
            except Exception:
                send_telegram(chat_id, "❌ Некорректный chat_id")
        elif has_access(chat_id):
            exp = time.strftime('%d.%m.%Y', time.localtime(ACCESS[chat_id]['expiry']))
