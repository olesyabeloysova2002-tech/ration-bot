            send_telegram(chat_id, "ℹ️ Платёжная ссылка: " + PAYMENT_LINK)

    elif text in ("💳 Подписка", "Подписка", "оплатить", "Оплатить"):
        paywall_message(chat_id)

    elif text in ("🔄 Другие блюда", "другие блюда"):
        if not has_access(chat_id):
            paywall_message(chat_id)
            return jsonify({"ok": True})
        if chat_id in LAST_REQ:
            send_telegram(chat_id, "🌟 Готовлю другие варианты…")
            req = dict(LAST_REQ[chat_id])
            old_excl = set(req.get("exclude_ids") or [])
            if chat_id in LAST_PLAN:
                old_excl |= set(_collect_dish_ids(LAST_PLAN[chat_id]))
            req["exclude_ids"] = list(old_excl)
            LAST_REQ[chat_id] = req

            def _do_reroll(chat_id=chat_id, req=req):
                try:
                    plan = generate_and_send(chat_id, req, add_reroll=True)
                    if "error" not in plan:
                        LAST_PLAN[chat_id] = plan
                        _save_state()
                except Exception as e:
                    log.exception("reroll failed: %s", e)
                    send_telegram(chat_id, "⚠️ Не получилось собрать другие блюда. Попробуй ещё раз.")
            threading.Thread(target=_do_reroll, daemon=True).start()
        else:
            send_telegram(chat_id, "Нет предыдущего плана — заполни форму на https://site-bb0.p.spru.io/")

    elif text_lower in ("ещё", "еще", "новые", "другие", "reroll", "/reroll"):
        if not has_access(chat_id):
            paywall_message(chat_id)
            return jsonify({"ok": True})
        if chat_id in LAST_REQ:
            send_telegram(chat_id, "🌟 Готовлю другие варианты…")
            req = dict(LAST_REQ[chat_id])
            old_excl = set(req.get("exclude_ids") or [])
            if chat_id in LAST_PLAN:
                old_excl |= set(_collect_dish_ids(LAST_PLAN[chat_id]))
            req["exclude_ids"] = list(old_excl)
            LAST_REQ[chat_id] = req

            def _do_reroll(chat_id=chat_id, req=req):
                try:
                    plan = generate_and_send(chat_id, req, add_reroll=True)
                    if "error" not in plan:
                        LAST_PLAN[chat_id] = plan
                        _save_state()
                except Exception as e:
                    log.exception("reroll failed: %s", e)
                    send_telegram(chat_id, "⚠️ Не получилось собрать другие блюда. Попробуй ещё раз.")
            threading.Thread(target=_do_reroll, daemon=True).start()
        else:
            send_telegram(chat_id, "Нет предыдущего плана — заполни форму на https://site-bb0.p.spru.io/")

    elif text:
        # любой другой текст — если нет подписки, объясняем что к чему
        if not has_access(chat_id):
            paywall_message(chat_id)
        else:
            send_telegram(chat_id, "Напиши «ещё» для новых блюд\nИли /start /test /menu /help")

    return jsonify({"ok": True})


def parse_calorie_request(form):
    family_size = int(form.get("family_size", 1) or 1)
    persons = []
    for i in range(family_size):
        persons.append({"kcal": form.get(f"person_{i}_kcal") or "1500", "meals": form.get(f"person_{i}_meals") or "5"})
    allergens = form.getlist("allergens") if hasattr(form, "getlist") else form.get("allergens", "")
    if isinstance(allergens, str):
        allergens = [allergens] if allergens else []
    other_all = form.get("allergens_other", "") or ""
    other_all = [x.strip() for x in other_all.split(",") if x.strip()]
    req = {
        "_mode": "calorie",
        "family_size": family_size,
        "persons": persons,
        "days": int(form.get("days", 7)),
        "budget": int(form.get("budget_value") or 0) or None,
        "allergens": [a for a in allergens if a] + other_all,
        "dislikes": [x.strip() for x in (form.get("dislike", "") or "").split(",") if x.strip()],
        "telegram": form.get("telegram", ""),
    }
    return req


def parse_budget_request(form):
    meal_types = form.getlist("meal_types") if hasattr(form, "getlist") else form.get("meal_types", [])
    excludes = form.getlist("exclude") if hasattr(form, "getlist") else form.get("exclude", [])
    if isinstance(excludes, str):
        excludes = [excludes] if excludes else []
    other_ex = form.get("exclude_other", "") or ""
    other_ex = [x.strip() for x in other_ex.split(",") if x.strip()]
    return {
        "_mode": "budget",
        "meal_types": meal_types if isinstance(meal_types, list) else [meal_types],
        "budget": int(form.get("budget_value") or form.get("budget") or 5000),
        "people": form.get("people", "1"),
        "days_b": int(form.get("days_b", 7)),
        "excludes": [e for e in excludes if e] + other_ex,
        "telegram": form.get("telegram_b") or form.get("telegram", ""),
    }


