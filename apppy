"""Webhook-сервер: приём заявок с сайта + Telegram bot с кнопкой 'Другие блюда'."""
import os, sys, logging, json, time
import requests
from flask import Flask, request, jsonify
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from menu_generator import (
    generate_calorie_plan, generate_budget_plan,
    format_telegram_message, _collect_dish_ids,
)

logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
log = logging.getLogger("ration-bot")

app = Flask(__name__)

@app.errorhandler(Exception)
def all_exceptions(e):
    import traceback
    log.error(f"Unhandled error: {e}\n{traceback.format_exc()}")
    return jsonify({"error": str(e), "trace": traceback.format_exc()}), 500


BOT_TOKEN = os.environ.get("BOT_TOKEN", "")
PUBLIC_URL = os.environ.get("PUBLIC_URL", "https://ration-bot-production.up.railway.app")
DATA_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "bot_state.json")
USER_CACHE = {}        # username.lower() -> chat_id
LAST_REQ = {}          # chat_id -> last req dict (с учётом exclude_ids от reroll)
LAST_PLAN = {}         # chat_id -> последний план (для возможного отображения)


def _load_state():
    """Загрузить кэш из файла (переживает рестарты)."""
    global USER_CACHE, LAST_REQ, LAST_PLAN
    try:
        if os.path.exists(DATA_FILE):
            with open(DATA_FILE, "r", encoding="utf-8") as f:
                d = json.load(f)
            USER_CACHE = d.get("users", {})
            # LAST_REQ/LAST_PLAN ключи должны быть str(chat_id)
            LAST_REQ = {int(k): v for k, v in d.get("last_req", {}).items()}
            LAST_PLAN = {int(k): v for k, v in d.get("last_plan", {}).items()}
            log.info(f"State loaded: users={len(USER_CACHE)}, plans={len(LAST_PLAN)}")
    except Exception as e:
        log.error(f"load_state failed: {e}")


def _save_state():
    """Сохранить кэш в файл (атомарно)."""
    try:
        d = {
            "users": USER_CACHE,
            "last_req": {str(k): v for k, v in LAST_REQ.items()},
            "last_plan": {str(k): v for k, v in LAST_PLAN.items()},
        }
        tmp = DATA_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(d, f, ensure_ascii=False)
        os.replace(tmp, DATA_FILE)
    except Exception as e:
        log.error(f"save_state failed: {e}")


_load_state()


def send_telegram(chat_id, text, reply_markup=None):
    try:
        payload = {"chat_id": chat_id, "text": text[:4000], "parse_mode": "Markdown"}
        if reply_markup is not None:
            payload["reply_markup"] = reply_markup
        r = requests.post(
            f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage",
            json=payload,
            timeout=10
        )
        return r.status_code == 200
    except Exception as e:
        log.error(f"send error: {e}")
        return False


def answer_callback(callback_query_id, text=""):
    try:
        requests.post(
            f"https://api.telegram.org/bot{BOT_TOKEN}/answerCallbackQuery",
            json={"callback_query_id": callback_query_id, "text": text, "show_alert": False},
            timeout=10
        )
    except Exception as e:
        log.error(f"answer_callback error: {e}")


def lookup_user(username):
    if not username:
        return None
    return USER_CACHE.get(username.lstrip("@").lower())


def cache_user(username, chat_id):
    if username and chat_id:
        USER_CACHE[username.lower()] = chat_id
        _save_state()


def reroll_keyboard():
    return {"inline_keyboard": [[{"text": "🔄 Другие блюда", "callback_data": "reroll"}]]}


def reroll_reply_keyboard():
    """Обычная клавиатура внизу чата — видна всегда, в отличие от inline."""
    return {
        "keyboard": [[{"text": "🔄 Другие блюда"}]],
        "resize_keyboard": True,
        "one_time_keyboard": False,
        "is_persistent": True,
    }


def remove_keyboard():
    return {"remove_keyboard": True}


def generate_and_send(chat_id, req, add_reroll=True):
    """Сгенерировать план по req, отправить в Telegram, вернуть результат."""
    mode = req.get("_mode") or ("budget" if "meal_types" in req else "calorie")
    if mode == "budget":
        plan = generate_budget_plan(req)
    else:
        plan = generate_calorie_plan(req)
    if "error" in plan:
        send_telegram(chat_id, f"⚠️ {plan['error']}")
        return plan
    # длинное меню
    send_telegram(chat_id, format_telegram_message(plan), reply_markup=None)
    # подсказка как получить новые блюда — текстом (не кнопкой)
    if add_reroll:
        send_telegram(
            chat_id,
            "📝 Чтобы получить другие блюда — напиши сюда слово «ещё»\n"
            "(или команду /reroll)",
        )
    return plan


@app.route(f"/webhook/{BOT_TOKEN}", methods=["POST"])
def webhook():
    upd = request.get_json(silent=True) or {}

    # inline-кнопка
    cb = upd.get("callback_query")
    if cb:
        cb_id = cb.get("id")
        data = cb.get("data", "")
        chat_id = cb.get("message", {}).get("chat", {}).get("id")
        if data == "reroll" and chat_id in LAST_REQ:
            answer_callback(cb_id, "Готовлю другие варианты…")
            req = dict(LAST_REQ[chat_id])
            # добираем exclude_ids из прошлого плана
            old_excl = set(req.get("exclude_ids") or [])
            if chat_id in LAST_PLAN:
                old_excl |= set(_collect_dish_ids(LAST_PLAN[chat_id]))
            req["exclude_ids"] = list(old_excl)
            LAST_REQ[chat_id] = req
            plan = generate_and_send(chat_id, req, add_reroll=True)
            if "error" not in plan:
                LAST_PLAN[chat_id] = plan
                _save_state()
        else:
            answer_callback(cb_id, "Нет предыдущего плана — заполни форму на сайте и получи меню")
        return jsonify({"ok": True})

    msg = upd.get("message")
    if not msg:
        return jsonify({"ok": True})
    chat_id = msg["chat"]["id"]
    username = msg.get("from", {}).get("username", "")
    text = (msg.get("text") or "").strip()
    if username:
        cache_user(username, chat_id)
    log.info(f"msg from @{username} ({chat_id}): {text}")

    if text.startswith("/start"):
        send_telegram(chat_id, "Привет! 👋 Бот «Индивидуальный рацион».\n\n📋 Собери меню на сайте: https://site-bb0.p.spru.io/\nКоманды: /test /menu /help")
        send_telegram(chat_id, "Готово 👍", reply_markup=reroll_reply_keyboard())
    elif text.startswith("/test"):
        req = {"_mode":"calorie","family_size":1,"persons":[{"kcal":"1500","meals":"3"}],"days":2,"budget":2000,"allergens":[],"dislikes":[]}
        plan = generate_and_send(chat_id, req, add_reroll=True)
        if "error" not in plan:
            LAST_REQ[chat_id] = req
            LAST_PLAN[chat_id] = plan
            _save_state()
    elif text.startswith("/menu"):
        req = {"_mode":"calorie","family_size":1,"persons":[{"kcal":"1500","meals":"3"}],"days":1,"budget":None,"allergens":[],"dislikes":[]}
        plan = generate_and_send(chat_id, req, add_reroll=True)
        if "error" not in plan:
            LAST_REQ[chat_id] = req
            LAST_PLAN[chat_id] = plan
            _save_state()
    elif text.startswith("/help"):
        send_telegram(chat_id, "1. Заполни форму на https://site-bb0.p.spru.io/\n2. Укажи свой @username\n3. Получи меню в Telegram\n4. Нажми 🔄 Другие блюда внизу чата, если хочешь новые варианты")
    elif text in ("🔄 Другие блюда", "🔄 Другие блюда ", "Другие блюда", "ещё", "еще", "Ещё", "Еще", "новые", "другие", "reroll", "/reroll"):
        # текстовая команда для новых блюд (iOS не показывает inline/reply-клавиатуры у этого клиента)
        if chat_id in LAST_REQ:
            send_telegram(chat_id, "🌟 Готовлю другие варианты…")
            req = dict(LAST_REQ[chat_id])
            old_excl = set(req.get("exclude_ids") or [])
            if chat_id in LAST_PLAN:
                old_excl |= set(_collect_dish_ids(LAST_PLAN[chat_id]))
            req["exclude_ids"] = list(old_excl)
            LAST_REQ[chat_id] = req
            plan = generate_and_send(chat_id, req, add_reroll=True)
            if "error" not in plan:
                LAST_PLAN[chat_id] = plan
                _save_state()
        else:
            send_telegram(chat_id, "Нет предыдущего плана — заполни форму на https://site-bb0.p.spru.io/")
    elif text:
        send_telegram(chat_id, "Напиши «ещё» для новых блюд\nИли /start /test /menu")
    return jsonify({"ok": True})


def parse_calorie_request(form):
    family_size = int(form.get("family_size", 1) or 1)
    persons = []
    for i in range(family_size):
        persons.append({"kcal": form.get(f"person_{i}_kcal") or "1500", "meals": form.get(f"person_{i}_meals") or "5"})
    allergens = form.getlist("allergens") if hasattr(form, "getlist") else form.get("allergens", "")
    req = {
        "_mode": "calorie",
        "family_size": family_size,
        "persons": persons,
        "days": int(form.get("days", 7)),
        "budget": int(form.get("budget_value") or 0) or None,
        "allergens": [a for a in (allergens if isinstance(allergens, list) else [allergens]) if a],
        "dislikes": [x.strip() for x in (form.get("dislike", "") or "").split(",") if x.strip()],
        "telegram": form.get("telegram", ""),
    }
    return req


def parse_budget_request(form):
    meal_types = form.getlist("meal_types") if hasattr(form, "getlist") else form.get("meal_types", [])
    excludes = form.getlist("exclude") if hasattr(form, "getlist") else form.get("exclude", [])
    return {
        "_mode": "budget",
        "meal_types": meal_types if isinstance(meal_types, list) else [meal_types],
        "budget": int(form.get("budget_value") or form.get("budget") or 5000),
        "people": form.get("people", "1"),
        "days_b": int(form.get("days_b", 7)),
        "excludes": [e for e in (excludes if isinstance(excludes, list) else [excludes]) if e],
        "telegram": form.get("telegram_b") or form.get("telegram", ""),
    }


@app.route("/health")
def health():
    return jsonify({"status": "ok", "bot": bool(BOT_TOKEN), "users": len(USER_CACHE), "plans": len(LAST_PLAN)})


@app.route("/generate", methods=["POST"])
def generate():
    try:
        form = request.form
        is_budget = form.get("mode") == "budget"
        req = parse_budget_request(form) if is_budget else parse_calorie_request(form)
        plan = generate_budget_plan(req) if is_budget else generate_calorie_plan(req)
        sent = False
        tg = req.get("telegram", "")
        if tg and "error" not in plan:
            cid = lookup_user(tg)
            if cid:
                sent = send_telegram(cid, format_telegram_message(plan), reply_markup=None)
                send_telegram(
                    cid,
                    "📝 Чтобы получить другие блюда — напиши сюда слово «ещё»\n"
                    "(или команду /reroll)",
                )
                LAST_REQ[cid] = req
                LAST_PLAN[cid] = plan
                _save_state()
                log.info(f"Sent to {tg} (chat_id={cid}): {sent}")
            else:
                log.warning(f"User {tg} not in cache — must /start the bot first")
        plan["sent_to_telegram"] = sent
        return jsonify(plan)
    except Exception as e:
        import traceback
        log.error(f"/generate crash: {e}\n{traceback.format_exc()}")
        return jsonify({"error": str(e), "trace": traceback.format_exc()}), 500


def setup_webhook():
    if not BOT_TOKEN:
        log.warning("BOT_TOKEN not set, skipping webhook setup")
        return
    try:
        url = f"{PUBLIC_URL}/webhook/{BOT_TOKEN}"
        r = requests.post(
            f"https://api.telegram.org/bot{BOT_TOKEN}/setWebhook",
            json={"url": url, "drop_pending_updates": True,
                  "allowed_updates": ["message", "callback_query"]},
            timeout=10
        )
        log.info(f"setWebhook: {r.json()}")
    except Exception as e:
        log.error(f"setWebhook failed: {e}")


setup_webhook()


