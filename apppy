"""Webhook-версия сервера: Telegram сам шлёт обновления на наш endpoint."""
import os, sys, logging, requests
from flask import Flask, request, jsonify
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from menu_generator import generate_calorie_plan, generate_budget_plan, format_telegram_message

logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
log = logging.getLogger("ration-bot")

app = Flask(__name__)

@app.errorhandler(Exception)
def all_exceptions(e):
    import traceback
    log.error(f"Unhandled error: {e}\n{traceback.format_exc()}")
    return jsonify({"error": str(e), "trace": traceback.format_exc()}), 500

BOT_TOKEN = os.environ.get("BOT_TOKEN", "")
PUBLIC_URL = os.environ.get("PUBLIC_URL", "https://ration-bot-production.up.railway.app")
USER_CACHE = {}


def send_telegram(chat_id, text):
    try:
        r = requests.post(
            f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage",
            json={"chat_id": chat_id, "text": text[:4000], "parse_mode": "Markdown"},
            timeout=10
        )
        return r.status_code == 200
    except Exception as e:
        log.error(f"send error: {e}")
        return False


def lookup_user(username):
    if not username:
        return None
    return USER_CACHE.get(username.lstrip("@").lower())


def cache_user(username, chat_id):
    if username and chat_id:
        USER_CACHE[username.lower()] = chat_id


@app.route(f"/webhook/{BOT_TOKEN}", methods=["POST"])
def webhook():
    upd = request.get_json(silent=True) or {}
    msg = upd.get("message")
    if not msg:
        return jsonify({"ok": True})
    chat_id = msg["chat"]["id"]
    username = msg.get("from", {}).get("username", "")
    text = (msg.get("text") or "").strip()
    if username:
        cache_user(username, chat_id)
    log.info(f"msg from @{username} ({chat_id}): {text}")
    if text.startswith("/start"):
        send_telegram(chat_id, "Привет! 👋 Бот «Индивидуальный рацион».\n\n📋 Собери меню на сайте: https://site-bb0.p.spru.io/\nКоманды: /test /menu /help")
    elif text.startswith("/test"):
        r = generate_calorie_plan({"family_size":1,"persons":[{"kcal":"1500","meals":"3"}],"days":2,"budget":2000,"allergens":[],"dislikes":[]})
        send_telegram(chat_id, format_telegram_message(r))
    elif text.startswith("/menu"):
        r = generate_calorie_plan({"family_size":1,"persons":[{"kcal":"1500","meals":"3"}],"days":1,"budget":None,"allergens":[],"dislikes":[]})
        send_telegram(chat_id, format_telegram_message(r))
    elif text.startswith("/help"):
        send_telegram(chat_id, "1. Заполни форму на https://site-bb0.p.spru.io/\n2. Укажи свой @username\n3. Получи меню в Telegram")
    elif text:
        send_telegram(chat_id, "Напиши /start, /test или /menu")
    return jsonify({"ok": True})


def parse_calorie_request(form):
    family_size = int(form.get("family_size", 1) or 1)
    persons = []
    for i in range(family_size):
        persons.append({"kcal": form.get(f"person_{i}_kcal") or "1500", "meals": form.get(f"person_{i}_meals") or "5"})
    allergens = form.getlist("allergens") if hasattr(form, "getlist") else form.get("allergens", "")
    return {"family_size":family_size,"persons":persons,"days":int(form.get("days",7)),"budget":int(form.get("budget_value") or 0) or None,"allergens":[a for a in (allergens if isinstance(allergens,list) else [allergens]) if a],"dislikes":[x.strip() for x in (form.get("dislike","") or "").split(",") if x.strip()],"telegram":form.get("telegram","")}


def parse_budget_request(form):
    meal_types = form.getlist("meal_types") if hasattr(form, "getlist") else form.get("meal_types", [])
    excludes = form.getlist("exclude") if hasattr(form, "getlist") else form.get("exclude", [])
    return {"meal_types":meal_types if isinstance(meal_types,list) else [meal_types],"budget":int(form.get("budget_value") or form.get("budget") or 5000),"people":form.get("people","1"),"days_b":int(form.get("days_b",7)),"excludes":[e for e in (excludes if isinstance(excludes,list) else [excludes]) if e],"telegram":form.get("telegram_b") or form.get("telegram","")}


@app.route("/health")
def health():
    return jsonify({"status":"ok","bot":bool(BOT_TOKEN),"users":len(USER_CACHE)})


@app.route("/generate", methods=["POST"])
def generate():
    try:
        form = request.form
        is_budget = form.get("mode") == "budget"
        req = parse_budget_request(form) if is_budget else parse_calorie_request(form)
        result = generate_budget_plan(req) if is_budget else generate_calorie_plan(req)
        sent = False
        tg = req.get("telegram","")
        if tg and "error" not in result:
            cid = lookup_user(tg)
            if cid:
                sent = send_telegram(cid, format_telegram_message(result))
                log.info(f"Sent to {tg} (chat_id={cid}): {sent}")
            else:
                log.warning(f"User {tg} not in cache — must /start the bot first")
        result["sent_to_telegram"] = sent
        return jsonify(result)
    except Exception as e:
        import traceback
        log.error(f"/generate crash: {e}\n{traceback.format_exc()}")
        return jsonify({"error": str(e), "trace": traceback.format_exc()}), 500


def setup_webhook():
    if not BOT_TOKEN:
        log.warning("BOT_TOKEN not set, skipping webhook setup")
        return
    try:
        url = f"{PUBLIC_URL}/webhook/{BOT_TOKEN}"
        r = requests.post(
            f"https://api.telegram.org/bot{BOT_TOKEN}/setWebhook",
            json={"url": url, "drop_pending_updates": True, "allowed_updates": ["message"]},
            timeout=10
        )
        log.info(f"setWebhook: {r.json()}")
    except Exception as e:
        log.error(f"setWebhook failed: {e}")


setup_webhook()


if __name__ == "__main__":
    port = int(os.environ.get("PORT", 8080))
    log.info(f"Starting Flask on port {port}")
    app.run(host="0.0.0.0", port=port, debug=False, use_reloader=False)
