        else:
            send_telegram(chat_id, "❌ Нет активной подписки")

    elif text.startswith("/grant"):
        # /grant <chat_id> <days> — только для админа
        if chat_id != ADMIN_CHAT_ID:
            send_telegram(chat_id, "⛔ Только для администратора")
        else:
            parts = text.split()
            if len(parts) >= 3:
                try:
                    target_cid = int(parts[1])
                    days = int(parts[2])
                    grant_access(target_cid, days, username=f"manual_by_admin")
                    send_telegram(chat_id, f"✅ Доступ выдан chat_id={target_cid} на {days} дней")
                except ValueError:
                    send_telegram(chat_id, "❌ Формат: /grant <chat_id> <days>")
            else:
                send_telegram(chat_id, "❌ Формат: /grant <chat_id> <days>")

    elif text.startswith("/revoke"):
        # /revoke <chat_id> — только для админа
        if chat_id != ADMIN_CHAT_ID:
            send_telegram(chat_id, "⛔ Только для администратора")
        else:
            parts = text.split()
            if len(parts) >= 2:
                try:
                    target_cid = int(parts[1])
                    if target_cid in ACCESS:
                        del ACCESS[target_cid]
                        _save_access()
                        send_telegram(chat_id, f"🚫 Подписка chat_id={target_cid} отменена")
                    else:
                        send_telegram(chat_id, "Нет такой подписки")
                except ValueError:
                    send_telegram(chat_id, "❌ Формат: /revoke <chat_id>")
            else:
                send_telegram(chat_id, "❌ Формат: /revoke <chat_id>")

    elif text.startswith("/subs"):
        # /subs — список всех подписок (только админ)
        if chat_id != ADMIN_CHAT_ID:
            send_telegram(chat_id, "⛔ Только для администратора")
        else:
            now = time.time()
            active = []
            expired = 0
            for cid, info in ACCESS.items():
                if info.get("expiry", 0) > now:
                    exp = time.strftime('%d.%m.%Y', time.localtime(info['expiry']))
                    active.append(f"  • {cid} (@{info.get('username','?')}) — до {exp}")
                else:
                    expired += 1
            text_msg = f"📊 *Подписки:* {len(active)} активных, {expired} истекших\n\n"
            text_msg += "\n".join(active[:30]) if active else "_Нет активных_"
            if len(active) > 30:
                text_msg += f"\n_...и ещё {len(active) - 30}_"
            send_telegram(chat_id, text_msg)

    elif text.startswith("/invoices"):
