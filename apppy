app = Flask(__name__)

@app.errorhandler(Exception)
def all_exceptions(e):
    import traceback
    log.error(f"Unhandled error: {e}\n{traceback.format_exc()}")
    return jsonify({"error": str(e), "trace": traceback.format_exc()}), 500


BOT_TOKEN = os.environ.get("BOT_TOKEN", "")
PUBLIC_URL = os.environ.get("PUBLIC_URL", "https://ration-bot-production.up.railway.app")
PAYMENT_LINK = os.environ.get("PAYMENT_LINK", "https://www.tbank.ru/cf/4Mn3682YClc")
PAYMENT_PRICE_RUB = int(os.environ.get("PAYMENT_PRICE_RUB", "499"))
ACCESS_DAYS = int(os.environ.get("ACCESS_DAYS", "30"))
ADMIN_CHAT_ID = int(os.environ.get("ADMIN_CHAT_ID", "1002816812"))

DATA_DIR = os.path.dirname(os.path.abspath(__file__))
DATA_FILE = os.path.join(DATA_DIR, "bot_state.json")
ACCESS_FILE = os.path.join(DATA_DIR, "access.json")

USER_CACHE = {}        # username.lower() -> chat_id
LAST_REQ = {}          # chat_id -> last req dict (с учётом exclude_ids от reroll)
LAST_PLAN = {}         # chat_id -> последний план
ACCESS = {}            # chat_id -> {"expiry": ts, "started_at": ts, "username": str}


def _load_state():
    """Загрузить кэш пользователей из файла (переживает рестарты)."""
    global USER_CACHE, LAST_REQ, LAST_PLAN
    try:
        if os.path.exists(DATA_FILE):
            with open(DATA_FILE, "r", encoding="utf-8") as f:
                d = json.load(f)
            USER_CACHE = d.get("users", {})
            LAST_REQ = {int(k): v for k, v in d.get("last_req", {}).items()}
            LAST_PLAN = {int(k): v for k, v in d.get("last_plan", {}).items()}
            log.info(f"State loaded: users={len(USER_CACHE)}, plans={len(LAST_PLAN)}")
    except Exception as e:
        log.error(f"load_state failed: {e}")


def _save_state():
    """Сохранить кэш пользователей в файл (атомарно)."""
    try:
        d = {
            "users": USER_CACHE,
            "last_req": {str(k): v for k, v in LAST_REQ.items()},
            "last_plan": {str(k): v for k, v in LAST_PLAN.items()},
        }
        tmp = DATA_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(d, f, ensure_ascii=False)
        os.replace(tmp, DATA_FILE)
    except Exception as e:
        log.error(f"save_state failed: {e}")


def _load_access():
    """Загрузить подписки из файла."""
    global ACCESS
    try:
        if os.path.exists(ACCESS_FILE):
            with open(ACCESS_FILE, "r", encoding="utf-8") as f:
                d = json.load(f)
            ACCESS = {int(k): v for k, v in d.items()}
            log.info(f"Access loaded: {len(ACCESS)} active subs")
    except Exception as e:
        log.error(f"load_access failed: {e}")


def _save_access():
    """Сохранить подписки в файл (атомарно)."""
    try:
        d = {str(k): v for k, v in ACCESS.items()}
        tmp = ACCESS_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(d, f, ensure_ascii=False)
        os.replace(tmp, ACCESS_FILE)
    except Exception as e:
        log.error(f"save_access failed: {e}")


def has_access(chat_id):
    """Проверить, есть ли у пользователя активная подписка."""
    if not ACCESS or chat_id not in ACCESS:
        return False
    return ACCESS[chat_id].get("expiry", 0) > time.time()


def grant_access(chat_id, days, username=""):
    """Выдать доступ на N дней."""
    now = time.time()
    ACCESS[chat_id] = {
        "expiry": now + days * 86400,
        "started_at": now,
        "username": username,
        "days": days,
    }
    _save_access()
    log.info(f"Access granted to chat_id={chat_id} ({username}) for {days} days")


_load_state()
_load_access()


def send_telegram(chat_id, text, reply_markup=None):
    try:
        payload = {"chat_id": chat_id, "text": text[:4000], "parse_mode": "Markdown"}
        if reply_markup is not None:
            payload["reply_markup"] = reply_markup
        r = requests.post(
            f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage",
            json=payload,
            timeout=10
        )
        return r.status_code == 200
    except Exception as e:
        log.error(f"send error: {e}")
        return False


